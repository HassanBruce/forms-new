APP_NAME=Tripdesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
APP_DOMAIN=app.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tripdesk
DB_USERNAME=tripdesk
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Invoice emails. Hostinger mail, Brevo, Mailgun, SES — any SMTP works.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=invoices@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME="${APP_NAME}"
